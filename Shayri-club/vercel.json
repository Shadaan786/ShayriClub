{
  "rewrites": [
    {
      "source": "/(:path*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i)(googlebot|bingbot|yandex|baiduspider|twitterbot|facebookexternalhit|rogerbot|linkedinbot|embedly|quora link preview|showyoubot|outbrain|pinterest\/0.|pinterestbot|slackbot|vkShare|W3C_Validator|whatsapp|openai|chatgpt|gptbot|anthropic|claude|perplexity)"
        }
      ],
      "destination": "https://prerender.io%{host}/$1?prerenderToken=$PRERENDER_TOKEN"
    },
    { 
      "source": "/(.*)", 
      "destination": "/" 
    }
  ]
}

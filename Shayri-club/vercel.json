{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "rewrites": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "Googlebot"
        }
      ],
      "destination": "/api/prerender?path=/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}